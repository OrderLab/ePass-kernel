# ePass: in-kernel eBPF compiler passes (kernel/bpf/epass.c). Merge with
# `make LLVM=1 epass.config`; Rust needs an LLVM build, and kfunc facts
# need BTF.
CONFIG_RUST=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_EPASS=y
# Rust needs !MODVERSIONS (or GENDWARFKSYMS); distribution configs enable
# it, and RUST would otherwise be silently dropped.
# CONFIG_MODVERSIONS is not set
